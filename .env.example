# Core runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zero_human_company
PUBLIC_BASE_URL=http://localhost:5173
PORT=3001
COOKIE_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-me
JUDGE_MODE=false
DEMO_HYBRID_MODE=false
REAL_ACTIONS_ENABLED=false
PROVIDER_MODE=fake

# Consenting role-players only. Never put discovered real contacts here.
LINQ_NORDLICHT_RECIPIENT=
LINQ_MAAS_RECIPIENT=
DOCUMENSO_BUYER_EMAIL=

# OpenRouter-routed GPT-5.6 Luna outreach
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Stripe Checkout. TEST is a real sandbox transaction and is the hackathon default.
STRIPE_MODE=TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Linq
LINQ_API_BASE_URL=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=

# Terac: set TRANSPORT to http only when your account exposes the documented endpoint.
TERAC_TRANSPORT=
TERAC_API_BASE_URL=
TERAC_API_KEY=
TERAC_STUDY_PATH=
TERAC_CONTRACT_REVIEW_PATH=

# Band external agents. Create these three identities in app.band.ai and give
# each identity to exactly one local/Render worker connection.
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_AGENT_BRAIN=CODEX
BAND_CODEX_THREAD_STATE_PATH=.runtime/band-thread-ids.json
BAND_CODEX_WORKING_DIRECTORY=.runtime/codex-empty-workdir
BAND_CODEX_RUNTIME_HOME=.runtime/codex-home
BAND_RESEARCHER_AGENT_ID=
BAND_RESEARCHER_API_KEY=
BAND_NEGOTIATOR_AGENT_ID=
BAND_NEGOTIATOR_API_KEY=
BAND_POLICY_AGENT_ID=
BAND_POLICY_AGENT_API_KEY=

# Documenso v2
DOCUMENSO_API_BASE_URL=https://app.documenso.com/api/v2
DOCUMENSO_API_KEY=
DOCUMENSO_TEMPLATE_ID=
DOCUMENSO_WEBHOOK_SECRET=
DOCUMENSO_CREATE_PATH=/envelope/use
DOCUMENSO_RECONCILE_PATH=/envelope?externalId={externalId}
DOCUMENSO_OWNER_RECIPIENT_ID=
DOCUMENSO_BUYER_RECIPIENT_ID=

# Monid runtime discovery
MONID_API_BASE_URL=
MONID_API_KEY=

# Render Workflows
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_WORKFLOW_SLUG=zero-human-company
